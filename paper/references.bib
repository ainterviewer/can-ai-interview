  issn = {1049-7323},
  url = {https://doi.org/10.1177/1049732309350879},
  doi = {10.1177/1049732309350879},
  abstract = {For qualitative researchers, maintaining respondent
              confidentiality while presenting rich, detailed accounts of social
              life presents unique challenges. These challenges are not
              adequately addressed in the literature on research ethics and
              research methods. Using an example from a study of breast cancer
              survivors, I argue that by carefully considering the audience for
              one?s research and by reenvisioning the informed consent process,
              qualitative researchers can avoid confidentiality dilemmas that
