@article{lazarsfeld_controversy_1944,
  title = {The {Controversy} {Over} {Detailed} {Interviews}-{An} {Offer} for {
           Negotiation}},
  volume = {8},
  issn = {0033-362X},
  url = {https://www.jstor.org/stable/2745687},
  abstract = {From the beginning, public opinion research has been badgered by
              the problem of "depth." Does a simple answer to a simple question
              really reveal a man's opinion? The controversy, if such it may be
              called, has grown not only between the critics and the pollsters,
              but among the pollsters themselves. Two philosophies of research
              have arisen; one wedded to so-called depth interviewing, the other
              content with more objective methods of research. In this article
              Dr. Lazarsfeld looks searchingly at the potential schism. His
              conclusion is that the difference between the two schools, though
              valid, need not be crucial; there is, in his opinion, a half-way
              house.},
  number = {1},
  urldate = {2024-10-29},
  journal = {The Public Opinion Quarterly},
  author = {Lazarsfeld, Paul F.},
  year = {1944},
  note = {Publisher: [Oxford University Press, American Association for Public
          Opinion Research]},
  pages = {38--60},
}

